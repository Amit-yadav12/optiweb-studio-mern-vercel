# Unikit Studio: server environment.
#
# Every variable here is optional. The app runs with none of them set.
#
# There is nothing to configure for images, stylesheets or asset files: they
# are processed in the visitor's browser and never reach the server. The server
# does one thing, the Website Audit, and these variables only tune it.
#
# Real values belong in the host's environment settings (Vercel: Project →
# Settings → Environment Variables; Netlify: Site configuration → Environment
# variables), never in the repository. Do not prefix any of them with VITE_:
# that would put the value into the browser bundle.

# ------------------------------------------------------------ website audit
# Google PageSpeed Insights API key. With it, an audit also reports Lighthouse
# lab scores and Chrome field data. Without it, that section says so and the
# rest of the audit is unaffected.
PAGESPEED_API_KEY=

# Limits of one audit. The values below are the defaults. Each is also a
# ceiling: a higher value is ignored (the number in brackets is the maximum).
# UNIKIT_AUDIT_MAX_PAGES=3               # pages per audit, the requested one included [3]
# UNIKIT_AUDIT_MAX_RESOURCES=25          # resources fetched per page [25]
# UNIKIT_AUDIT_MAX_HTML_MB=1             # largest page document that is read [1]
# UNIKIT_AUDIT_MAX_RESOURCE_MB=1         # largest resource that is read [1]
# UNIKIT_AUDIT_MAX_TOTAL_MB=24           # bytes one audit may read in total [48]
# UNIKIT_AUDIT_TIMEOUT_MS=4000           # per request [8000]
# UNIKIT_AUDIT_TOTAL_TIMEOUT_MS=45000    # the whole audit [120000]
# UNIKIT_AUDIT_PAGESPEED_TIMEOUT_MS=10000  # time kept for PageSpeed Insights [12000]

# ------------------------------------------------------------------- server
# Port of the Node server (`npm start`, `npm run dev:server`). Ignored on
# Vercel and Netlify, where the API runs as a function.
# PORT=5000

# -------------------------------------------------------------------- build
# Public address of the site, used at build time for the absolute URL of the
# social preview image. On Vercel and Netlify it is detected automatically.
# SITE_URL=https://your-domain.example

# Development only: where `npm run dev:client` forwards /api requests.
# DEV_API_URL=http://localhost:5000

# ---------------------------------------------------------- no longer used
# Earlier versions uploaded files to the server and stored results. That is
# gone, and so are these variables. If they are still set on a host, delete
# them there; the app does not read them:
#   a database connection string, an object-storage token, a cron secret,
#   CLIENT_ORIGIN, VITE_API_BASE_URL, and the upload, storage, quota and job
#   settings that started with OW_.
# The audit limits were renamed from OW_AUDIT_* to UNIKIT_AUDIT_*. The old
# names are still read, so an existing deployment keeps its settings.
