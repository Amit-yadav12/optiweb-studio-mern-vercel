# Required in the Netlify site environment for durable job history,
# preferences, and downloadable artifacts. Configure a restricted Atlas user.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/optiweb?retryWrites=true&w=majority

# Optional: allow browser calls from an additional trusted origin. Keep empty for
# the same-origin Netlify frontend + Functions deployment.
CLIENT_ORIGIN=
VITE_API_BASE_URL=

# Netlify Functions: binary request payloads have an effective ~4.5 MB budget
# after Base64 encoding. Keep complete multipart requests below that ceiling.
OW_MAX_FILE_MB=1
OW_MAX_BATCH_MB=3.8
OW_MAX_FILES=4
OW_MAX_ARTIFACT_MB=3.5
OW_MAX_ZIP_MB=3.5
OW_IMAGE_TIMEOUT_MS=15000
OW_IMAGE_CONCURRENCY=2
OW_MAX_DECODED_PIXELS=24000000
OW_MAX_CSS_CHARS=400000
OW_ARTIFACT_TTL_HOURS=720
OW_AUDIT_MAX_HTML_KB=700
OW_AUDIT_MAX_RESOURCE_KB=400
OW_AUDIT_MAX_RESOURCES=16
OW_AUDIT_TIMEOUT_MS=4000
OW_AUDIT_TOTAL_TIMEOUT_MS=45000
OW_AUDIT_PAGESPEED_TIMEOUT_MS=10000
OW_AUDIT_MAX_PAGES=1
OW_MONGO_POOL_MAX=3
OW_MONGO_TIMEOUT_MS=5000

# Optional: PageSpeed Insights lab / CrUX field data.
# PAGESPEED_API_KEY=
