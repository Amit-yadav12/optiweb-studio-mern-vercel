# OptiWeb Studio — server environment.
#
# Placeholders only. Real values belong in the host's environment settings
# (Vercel: Project → Settings → Environment Variables), never in the repository.
# None of these variables may be prefixed with VITE_: that would put them in
# the browser bundle.

# ---------------------------------------------------------------- database
# MongoDB Atlas connection string, with a database name. Required for History,
# stored results, and the whole direct-upload pipeline (jobs, quotas, records).
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/optiweb?retryWrites=true&w=majority
OW_MONGO_POOL_MAX=3
OW_MONGO_TIMEOUT_MS=5000

# ---------------------------------------------------------- object storage
# Read-write token of a PRIVATE Vercel Blob store. Vercel adds it when you
# create the store with "Add a read-write token env var to this connection".
# With it (and a working database) files are uploaded straight from the browser
# to the store and processed by a background job. Without it the application
# uses the standard upload inside the request, with the small limits below.
BLOB_READ_WRITE_TOKEN=

# Storage driver. Leave empty on Vercel. "local" stores objects on disk and is
# for development on a long-lived server only; "none" switches direct uploads off.
OW_STORAGE_DRIVER=
# OW_LOCAL_STORAGE_DIR=./.data/objects

# ------------------------------------------------------- scheduled cleanup
# Random string of at least 16 letters and digits. Vercel sends it as
# "Authorization: Bearer …" when it calls /api/v1/internal/cron once a day.
# Without it the cleanup endpoint refuses every request.
CRON_SECRET=
# Optional separate secret for GET /api/v1/internal/usage (application-wide usage).
# OW_ADMIN_TOKEN=

# ------------------------------------------- capacity (direct uploads only)
# These are ceilings as well as defaults: a higher value is ignored, because
# larger sizes have not been load-tested on the deployed runtime.
OW_MAX_FILE_MB=25
OW_MAX_FILES=10
OW_MAX_BATCH_MB=150
OW_MAX_DECODED_PIXELS=40000000
OW_MAX_TOTAL_BATCH_PIXELS=160000000
OW_MAX_ARTIFACT_MB=50
OW_MAX_ZIP_MB=250
# AVIF needs far more memory than other formats; larger outputs are refused.
OW_AVIF_MAX_PIXELS=16000000
# Time limit of one encode inside a background job.
OW_JOB_IMAGE_TIMEOUT_MS=120000

# Reserved for a later release. Reading "true" here changes nothing yet:
# /api/v1/limits reports that advanced capacity was requested and is not enabled.
OW_LARGE_CAPACITY_ENABLED=false

# ------------------------------------------------------ quotas and retention
OW_SESSION_STORAGE_QUOTA_MB=500
OW_MAX_ACTIVE_JOBS_PER_SESSION=2
OW_MAX_JOB_RETRIES=2
# Source uploads are deleted this long after their job finished.
OW_SOURCE_TTL_HOURS=24
# Converted files are deleted this long after they were created.
OW_ARTIFACT_TTL_HOURS=720
# Job records stay in History this long.
OW_HISTORY_TTL_DAYS=180

# ------------------------------------------------------------ cost controls
# Uploads are refused once all sessions together store this much, or have
# uploaded this much today. Set both to what your storage plan allows.
OW_GLOBAL_STORAGE_BUDGET_MB=2048
OW_GLOBAL_DAILY_UPLOAD_MB=4096

# ------------------------------------------------------------------ worker
# How long one worker run keeps taking files. Keep it below the function's
# maxDuration in vercel.json (300 seconds).
OW_WORKER_BUDGET_SECONDS=240
OW_JOB_LEASE_SECONDS=150
OW_UPLOAD_TOKEN_TTL_MINUTES=20
OW_UPLOAD_PHASE_TTL_MINUTES=120

# ---------------------------------------- standard uploads (inside a request)
# Used when direct uploads are not available. The host limits a request body
# to 4.5 MB, so these can be lowered but not raised above their defaults,
# except OW_REQUEST_MAX_FILE_MB (up to 3.8) and OW_REQUEST_MAX_FILES (up to 10).
OW_REQUEST_MAX_FILE_MB=1
OW_REQUEST_MAX_BATCH_MB=3.8
OW_REQUEST_MAX_FILES=4
OW_REQUEST_MAX_DECODED_PIXELS=24000000
OW_REQUEST_MAX_ARTIFACT_MB=3.5
OW_REQUEST_MAX_ZIP_MB=3.5
# Converted images returned inside the response when they could not be stored.
OW_MAX_INLINE_MB=3
OW_IMAGE_TIMEOUT_MS=15000
OW_IMAGE_CONCURRENCY=2

# ----------------------------------------------------------- other tools
# CSS accepted by the Font Optimizer, in MB of text.
OW_MAX_CSS_MB=1
# Files per Asset Analyzer request. Their combined size is bounded by OW_REQUEST_MAX_BATCH_MB.
OW_MAX_ASSET_FILES=10
# Website audit: pages (same origin), resources per page, sizes, total bytes, time.
OW_AUDIT_MAX_PAGES=3
OW_AUDIT_MAX_RESOURCES=25
OW_AUDIT_MAX_HTML_MB=1
OW_AUDIT_MAX_RESOURCE_MB=1
OW_AUDIT_MAX_TOTAL_MB=24
OW_AUDIT_TIMEOUT_MS=4000
OW_AUDIT_TOTAL_TIMEOUT_MS=45000
OW_AUDIT_PAGESPEED_TIMEOUT_MS=10000
# Optional: PageSpeed Insights lab data and CrUX field data.
# PAGESPEED_API_KEY=

# ----------------------------------------------------------------- browser
# Optional: allow browser calls from an additional trusted origin. Leave empty
# when the frontend and the API are served from the same site.
CLIENT_ORIGIN=
VITE_API_BASE_URL=
