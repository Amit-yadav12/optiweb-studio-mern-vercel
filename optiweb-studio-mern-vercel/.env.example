# Required in production for persistent job history and downloadable artifacts.
# Create a MongoDB Atlas database, then paste the connection string here.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/optiweb?retryWrites=true&w=majority

# Optional: allow browser calls from another frontend origin. For a single Vercel
# deployment, keep empty so the frontend and API use the same origin.
CLIENT_ORIGIN=
VITE_API_BASE_URL=

# Vercel-safe upload settings. Keep request bodies below Vercel's 4.5 MB limit.
OW_MAX_FILE_MB=1
OW_MAX_BATCH_MB=3.8
OW_MAX_FILES=4
OW_MAX_ARTIFACT_MB=3.5
OW_MAX_ZIP_MB=3.5
OW_IMAGE_TIMEOUT_MS=15000
OW_IMAGE_CONCURRENCY=2
OW_MAX_DECODED_PIXELS=24000000
OW_MAX_CSS_CHARS=400000
OW_ARTIFACT_TTL_HOURS=720
OW_AUDIT_MAX_HTML_KB=700
OW_AUDIT_MAX_RESOURCE_KB=400
OW_AUDIT_MAX_RESOURCES=16
OW_AUDIT_TIMEOUT_MS=4000
OW_AUDIT_TOTAL_TIMEOUT_MS=45000
OW_AUDIT_PAGESPEED_TIMEOUT_MS=10000
OW_AUDIT_MAX_PAGES=1
OW_MONGO_POOL_MAX=3
OW_MONGO_TIMEOUT_MS=5000

# Optional: PageSpeed Insights lab / CrUX field data.
# PAGESPEED_API_KEY=
